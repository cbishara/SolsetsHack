# Sin ninguna variable, el server corre en memoria con la noche sintética (POST /api/simulate/night).
PORT=3002

# Token que manda la app en "Authorization: Bearer ...". Obligatorio con base o fuentes reales.
API_TOKEN=

# Postgres de Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}. Usa su propio esquema "server".
DATABASE_URL=

# URL pública HTTPS del server (para registrar los webhooks).
PUBLIC_URL=

# WhatsApp por Unipile. Copia este archivo a .env.local para desarrollo.
# Solo servidor: nunca incluir estas variables en EXPO_PUBLIC_*.
UNIPILE_DSN=
UNIPILE_API_KEY=
UNIPILE_ACCOUNT_ID=
# Secreto distinto de API_TOKEN, de al menos 32 caracteres.
UNIPILE_WEBHOOK_SECRET=
# Demo local durable. En Railway es obligatorio DATABASE_URL.
LOCAL_DATA_FILE=.data/sol-demo.jsonl
ALLOW_SIMULATE=false

# Multiusuario candidato: OFF hasta verificar contrato Quito y recorrido real.
# Al activarlo reemplaza el transporte legado /api/whatsapp por /api/v1.
SOL_MULTIUSER_ENABLED=false
UNIPILE_BOT_ACCOUNT_ID=
SOL_IDENTITY_SECRET=
SOL_MULTIUSER_WEBHOOK_SECRET=

# WhatsApp por 2Chat. Usar SOLO el número de demo, nunca uno personal ni el de Solsets.
TWOCHAT_API_KEY=
TWOCHAT_NUMBER=
# Secreto largo y al azar: openssl rand -hex 24. Va dentro de la URL del webhook.
TWOCHAT_WEBHOOK_TOKEN=

# Correo por IMAP. En Gmail: cuenta de demo con verificación en 2 pasos y una contraseña de aplicación.
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=
# Solo lee correos no leídos con este texto en el asunto. Vacío = todos los no leídos.
EMAIL_SUBJECT_FILTER=[SOLSETS-DEMO]
EMAIL_POLL_SECONDS=30
