{
  "name": "sol-mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.17",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "js-base64": "3.9.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-device-activity": "0.6.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --go",
    "android": "expo start --go --android",
    "ios": "expo start --go --ios",
    "web": "expo start --web",
    "start:native": "expo start --dev-client",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "export:check": "expo export --platform all",
    "prebuild:screen-time": "SOL_SCREEN_TIME=1 expo prebuild --platform ios --no-install",
    "verify:pilot": "tsx scripts/verify-pilot.ts",
    "run:ios": "expo run:ios"
  },
  "private": true,
  "overrides": {
    "uuid": "11.1.1"
  }
}
