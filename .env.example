# Sin estas variables, el panel y el recorrido sintético funcionan igualmente.
PORT=3001
APP_URL=http://localhost:5173
DATA_DIR=.data

# Railway PostgreSQL: usar referencia ${{Postgres.DATABASE_URL}} en Railway.
# Alternativa a Supabase, no configurar ambos proveedores a la vez.
DATABASE_URL=

# Obligatoria si habilitas cualquier integración real. Usuario del panel: solsets.
DASHBOARD_PASSWORD=

# Ejecutar las dos migraciones SQL antes de configurar Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud: habilitar Gmail API y Calendar API; OAuth de aplicación web.
# Callback: APP_URL/auth/google/callback. Agregar la cuenta demo a test users.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary
# Generar con: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Kapso webhook v2: APP_URL/api/webhooks/kapso, evento whatsapp.message.received
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WEBHOOK_SECRET=
# Números de prueba con código de país y sin +. Iniciar conversación antes de la demo.
RODRIGO_WHATSAPP_NUMBER=
KAPSO_ALLOWED_NUMBERS=

# URL privada del contenedor Hermes, incluyendo /v1.
HERMES_BASE_URL=http://hermes:8642/v1
HERMES_API_KEY=
# Proveedor que configurarán en Hermes (Anthropic en esta propuesta).
ANTHROPIC_API_KEY=
