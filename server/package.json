    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
