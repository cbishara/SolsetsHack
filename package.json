    "tablero:check": "node docs/equipo/quito/tablero/herramientas/build.mjs --check",
    "tablero:test": "node --test docs/equipo/quito/tablero/herramientas/model.test.mjs",
    "tablero:importar": "node docs/equipo/quito/tablero/herramientas/build.mjs --import-layout",
